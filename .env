# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
# IPs (comma-separated) of the reverse proxy allowed to set X-Forwarded-* headers.
# Same-host nginx/proxy: 127.0.0.1,::1 — proxy on another box: use its IP, or the
# keyword "private_ranges" to trust all private subnets. Empty = trust nothing.
TRUSTED_PROXIES=127.0.0.1,::1
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/ai-generic-platform ###
# GENERIC_BASE_URL=https://api.example.com/v1
###< symfony/ai-generic-platform ###

###> symfony/ai-lm-studio-platform ###
LM_STUDIO_HOST_URL=http://localhost:1234
###< symfony/ai-lm-studio-platform ###

###> app ###
APP_API_TOKEN=
APP_INSTANCE_URL=http://localhost:8000
APP_ARCHIVE_DIR=%kernel.project_dir%/var/archives
APP_CHROME_PATH=
# Optional path to ImageMagick's convert/magick (else auto-detected). When it can
# rasterise PDFs, the screenshot + card thumbnail are derived from the PDF instead
# of a second Chrome load / an og:image download.
APP_CONVERT_PATH=
# Optional path to Ghostscript's `gs` (else auto-detected). Used by app:compress-pdfs
# and by PdfArchiver to recompress captured PDFs. When absent, compression is skipped.
APP_GHOSTSCRIPT_PATH=
# Ghostscript preset applied to freshly captured PDFs (screen|ebook|printer|prepress).
# 'screen' = smallest/72dpi, 'ebook' = 150dpi balance. Lower dpi also softens the
# card thumbnail (rasterised from the PDF's first page).
APP_PDF_COMPRESS_QUALITY=ebook
# Max seconds Chrome may spend rendering a page to PDF before the capture is
# aborted. Slow/heavy pages otherwise stall the whole indexing run; a failed
# PDF is skipped without failing the link.
APP_PDF_TIMEOUT=10
APP_AI_ENABLED=false
# Must match a model key registered in config/packages/ai.yaml (ai.model.lmstudio)
APP_AI_TAG_MODEL=qwen3-vl-8b-instruct
# Language the AI writes tags AND summaries in, whatever the page language: fr | en
APP_AI_TAG_LANG=fr
# Pause (ms) between each call to the AI server, to avoid hammering it (0 = none)
APP_AI_CALL_DELAY_MS=1000
APP_AI_SUMMARY_MODEL=qwen3-vl-8b-instruct
# Max bookmarks per AI request when organizing a folder (phase-1 sample size and
# phase-2 chunk size). Above ~130, qwen3 reasoning overflows and LM Studio 400s
# ("Channel Error"). Lower it if you still hit that; raise it if your model copes.
APP_AI_CHUNK_LINKS=120
###< app ###
