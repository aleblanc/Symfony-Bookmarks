<aside class="sidebar" id="sidebar">
    <div class="brand" data-rail-toggle role="button" tabindex="0"
         title="{{ 'nav.collapse_menu'|trans }}" aria-label="{{ 'nav.collapse_menu'|trans }}">
        <span class="logo">🔖</span> {{ 'app.name'|trans }}
    </div>

    {% set current = current_dashboard() %}
    <form class="switch-form" method="post" action="#" onsubmit="event.preventDefault(); const id=this.elements.dashboard.value; fetch(window.APP_BASE + '/dashboard/switch/'+id, {method:'POST'}).then(()=>location.reload());">
        <select name="dashboard" class="input" onchange="this.form.requestSubmit()">
            {% for d in all_dashboards() %}
                <option value="{{ d.id }}" {{ current and current.id == d.id ? 'selected' : '' }}>{{ d.name }}</option>
            {% endfor %}
        </select>
    </form>
    {% if current %}
        <span class="dash-badge" style="background: {{ current.color }};">● {{ current.name }}</span>
    {% endif %}

    <form class="sidebar-search" action="{{ path('links_index') }}" method="get">
        <span class="sidebar-search-ic">🔍</span>
        <input class="input" type="search" name="q" placeholder="{{ 'sidebar.search_placeholder'|trans }}">
    </form>

    <h2>{{ 'nav.section'|trans }}</h2>
    <ul class="nav">
        <li><a href="{{ path('dashboard') }}"><span class="ico">🏠</span> {{ 'nav.home'|trans }}</a></li>
        <li><a href="{{ path('links_index') }}"><span class="ico">🔗</span> {{ 'nav.all_links'|trans }}</a></li>
        <li><a href="{{ path('links_new') }}"><span class="ico">➕</span> {{ 'nav.new_link'|trans }}</a></li>
        <li><a href="{{ path('import_index') }}"><span class="ico">📥</span> {{ 'nav.import'|trans }}</a></li>
    </ul>

    {% import '_partials/_folder_icon.html.twig' as fi %}
    {% import 'layout/_collection_tree.html.twig' as tree %}
    {% set nodes = sidebar_collections() %}

    {# Rail (collapsed) shortcut: root collections as colored folder icons.
       Hidden on the full sidebar — the tree below takes over there. #}
    <nav class="rail-collections" aria-label="{{ 'nav.collections'|trans }}">
        {% for node in nodes %}
            <a class="rail-col" href="{{ path('collections_show', {id: node.collection.id}) }}"
               title="{{ node.collection.name }}">{{ fi.icon(node.collection) }}</a>
        {% endfor %}
        <a class="rail-col rail-col-add" href="{{ path('collections_index') }}" title="{{ 'sidebar.manage'|trans }}">⚙</a>
    </nav>

    <details class="collapse" id="col-collections" open>
        <summary>
            <span class="chevron">▸</span>
            <span class="ico">📁</span> {{ 'nav.collections'|trans }}
            <a class="manage" href="{{ path('collections_index') }}" title="{{ 'sidebar.manage'|trans }}">⚙</a>
        </summary>
        {% if nodes is empty %}
            <ul class="nav nav-sub"><li><a href="{{ path('collections_new') }}">➕ {{ 'dashboard.create_first_collection'|trans }}</a></li></ul>
        {% else %}
            {{ tree.render(nodes) }}
        {% endif %}
    </details>

    <details class="collapse" id="col-tags" open>
        <summary>
            <span class="chevron">▸</span>
            <span class="ico">🏷️</span> {{ 'sidebar.tags'|trans }}
            <a class="manage" href="{{ path('tags_index') }}" title="{{ 'sidebar.all_tags'|trans }}">☰</a>
        </summary>
        {% set stags = sidebar_tags() %}
        <ul class="nav nav-sub">
            {% for row in stags %}
                <li><a href="{{ path('links_index', {tag: row.tag.id}) }}">
                    <span class="chevron-spacer"></span>
                    <span class="label">#{{ row.tag.name }}</span>
                    <span class="count">{{ row.count }}</span>
                </a></li>
            {% else %}
                <li><span class="muted" style="padding:6px 10px;display:block;">{{ 'dashboard.no_tags'|trans }}</span></li>
            {% endfor %}
        </ul>
        {% if stags|length >= 50 %}
            <a class="nav-more" href="{{ path('tags_index') }}">{{ 'sidebar.all_tags'|trans }} →</a>
        {% endif %}
    </details>

    <h2>{{ 'sidebar.features'|trans }}</h2>
    {% set feat = archive_features() %}
    <ul class="feature-list">
        <li>{{ 'sidebar.feature.readable'|trans }}   <span class="pill {{ feat.readable ? 'on' : 'off' }}">{{ (feat.readable ? 'sidebar.yes' : 'sidebar.no')|trans }}</span></li>
        <li>{{ 'sidebar.feature.singlefile'|trans }} <span class="pill {{ feat.singlefile ? 'on' : 'off' }}">{{ (feat.singlefile ? 'sidebar.yes' : 'sidebar.no')|trans }}</span></li>
        <li>{{ 'sidebar.feature.screenshot'|trans }} <span class="pill {{ feat.screenshot ? 'on' : 'off' }}">{{ (feat.screenshot ? 'sidebar.yes' : 'sidebar.no')|trans }}</span></li>
        <li>{{ 'sidebar.feature.pdf'|trans }}        <span class="pill {{ feat.pdf ? 'on' : 'off' }}">{{ (feat.pdf ? 'sidebar.yes' : 'sidebar.no')|trans }}</span></li>
    </ul>

    <h2>{{ 'sidebar.theme'|trans }}</h2>
    <div class="theme-switch" role="group">
        <button type="button" data-theme-set="light" title="{{ 'theme.day'|trans }}">☀️</button>
        <button type="button" data-theme-set="sepia" title="{{ 'theme.sepia'|trans }}">📜</button>
        <button type="button" data-theme-set="dark" title="{{ 'theme.night'|trans }}">🌙</button>
    </div>

    <script>
        (function () {
            var buttons = document.querySelectorAll('[data-theme-set]');
            function markActive() {
                var cur = document.documentElement.dataset.theme;
                buttons.forEach(function (b) { b.classList.toggle('active', b.dataset.themeSet === cur); });
            }
            buttons.forEach(function (b) {
                b.addEventListener('click', function () {
                    document.documentElement.dataset.theme = b.dataset.themeSet;
                    localStorage.setItem('theme', b.dataset.themeSet);
                    markActive();
                });
            });
            markActive();
        })();
        document.querySelectorAll('details.collapse').forEach(function (d) {
            var key = 'collapse:' + d.id;
            if (localStorage.getItem(key) === 'closed') { d.open = false; }
            d.addEventListener('toggle', function () {
                localStorage.setItem(key, d.open ? 'open' : 'closed');
            });
        });
        // Rail: click the brand to expand/collapse the sidebar (state persisted).
        var railToggle = document.querySelector('[data-rail-toggle]');
        if (railToggle) {
            function toggleRail() {
                var open = document.documentElement.classList.toggle('rail-open');
                localStorage.setItem('railOpen', open ? '1' : '0');
            }
            railToggle.addEventListener('click', toggleRail);
            railToggle.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleRail(); }
            });
        }
    </script>
</aside>
