{% extends 'base.html.twig' %}
{% block title %}{{ 'dashboard.title'|trans }} — {{ dashboard.name }}{% endblock %}
{% block body %}
    <header class="top">
        <h1>{{ dashboard.name }}</h1>
        <a href="{{ path('links_new') }}" class="btn btn-primary">➕ {{ 'link.new'|trans }}</a>
    </header>

    <section>
        <h2>{{ 'dashboard.recent_links'|trans }}</h2>
        {% if recent_links is empty %}
            <p class="muted">{{ 'dashboard.empty'|trans }}</p>
        {% else %}
            <div class="cards">
                {% for link in recent_links %}{% include 'links/_card.html.twig' %}{% endfor %}
            </div>
        {% endif %}
    </section>

    <section>
        <h2>{{ 'dashboard.collections_count'|trans({'%count%': collections|length}) }}</h2>
        <ul class="nav">
            {% for c in collections %}
                <li><a href="{{ path('links_index', {collection: c.id}) }}"><span class="swatch" style="background:{{ c.color }};"></span> {{ c.name }}</a></li>
            {% else %}
                <li><a href="{{ path('collections_new') }}">➕ {{ 'dashboard.create_first_collection'|trans }}</a></li>
            {% endfor %}
        </ul>
    </section>

    <section>
        <h2>{{ 'dashboard.tags_count'|trans({'%count%': tags|length}) }}</h2>
        {% for t in tags %}
            <a href="{{ path('links_index', {tag: t.id}) }}"><span class="tag">#{{ t.name }}</span></a>
        {% else %}
            <p class="muted">{{ 'dashboard.no_tags'|trans }}</p>
        {% endfor %}
    </section>
{% endblock %}
