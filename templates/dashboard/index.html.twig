{% extends 'base.html.twig' %}
{% import '_partials/_folder_icon.html.twig' as fi %}
{% block title %}{{ 'dashboard.title'|trans }} — {{ dashboard.name }}{% endblock %}
{% block body %}
    <header class="top">
        <h1>{{ dashboard.name }}</h1>
        <a href="{{ path('links_new') }}" class="btn btn-primary">➕ {{ 'link.new'|trans }}</a>
    </header>

    {% if clicked is empty and most_clicked is empty and added is empty and by_collection is empty %}
        <p class="muted">{{ 'dashboard.empty'|trans }}</p>
    {% endif %}

    {% if clicked is not empty %}
        <section>
            <h2>👆 {{ 'dashboard.recent_clicked'|trans }}</h2>
            <div class="link-strip">
                {% for link in clicked %}{% include 'links/_card.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endif %}

    {% if most_clicked is not empty %}
        <section>
            <h2>🔥 {{ 'dashboard.most_clicked'|trans }}</h2>
            <div class="link-strip">
                {% for link in most_clicked %}{% include 'links/_card.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endif %}

    {% if added is not empty %}
        <section>
            <h2>🆕 {{ 'dashboard.recent_added'|trans }}</h2>
            <div class="link-strip">
                {% for link in added %}{% include 'links/_card.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endif %}

    {% for row in by_collection %}
        <section>
            <h2>
                <a href="{{ path('collections_show', {id: row.collection.id}) }}">{{ fi.icon(row.collection) }} {{ row.collection.name }}</a>
            </h2>
            <div class="link-strip">
                {% for link in row.links %}{% include 'links/_card.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endfor %}
{% endblock %}
