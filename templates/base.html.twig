<!doctype html>
<html lang="{{ app.request.locale|default('fr') }}" data-theme="sepia">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
    {# Explicit favicon: without it the browser requests /favicon.ico at the domain
       root, escaping the reverse-proxy sub-path. asset() prepends the base path. #}
    <link rel="icon" href="{{ asset('favicon.svg') }}">
    {# Base path (includes the X-Forwarded-Prefix sub-path) for hardcoded JS fetches. #}
    <script>window.APP_BASE = {{ app.request.basePath|json_encode|raw }};</script>
    <script>(function(){var t=localStorage.getItem('theme');if(t){document.documentElement.dataset.theme=t;}
        if(localStorage.getItem('railOpen')==='1'){document.documentElement.classList.add('rail-open');}})();</script>
    <style>
        :root {
            --radius: 12px; --radius-sm: 8px; --radius-pill: 999px;
            --space: 20px;
        }
        /* Day */
        [data-theme="light"] {
            --bg: #f5f7fb; --fg: #0f172a; --muted: #64748b; --border: #e6eaf1;
            --card: #ffffff; --card-2: #fbfcfe;
            --primary: #4f46e5; --primary-fg: #ffffff; --primary-soft: #eef2ff;
            --danger: #e11d48; --danger-soft: #fff1f3;
            --ok: #059669; --ok-soft: #ecfdf5;
            --warn: #d97706; --warn-soft: #fffbeb;
            --shadow: 0 1px 2px rgba(15,23,42,.04), 0 4px 16px rgba(15,23,42,.06);
            --shadow-hover: 0 2px 4px rgba(15,23,42,.06), 0 12px 28px rgba(15,23,42,.10);
        }
        /* Warm — prune / rouille / ocre (default) */
        [data-theme="sepia"] {
            --bg: #f3d3bd; --fg: #3f2833; --muted: #94705e; --border: #e6cfa5;
            --card: #fbeee0; --card-2: #f4dbc6;
            --primary: #b0532b; --primary-fg: #fdf5ea; --primary-soft: #f1dcc2;
            --danger: #a83b32; --danger-soft: #f4dcd2;
            --ok: #6e7d3c; --ok-soft: #ebe9cd;
            --warn: #bd7d1c; --warn-soft: #f4e6c1;
            --shadow: 0 1px 2px rgba(63,40,51,.07), 0 4px 16px rgba(63,40,51,.11);
            --shadow-hover: 0 2px 4px rgba(63,40,51,.11), 0 12px 28px rgba(63,40,51,.18);
        }
        /* Night */
        [data-theme="dark"] {
            --bg: #0b1120; --fg: #e8edf6; --muted: #94a3b8; --border: #1e293b;
            --card: #131c2e; --card-2: #0f1728;
            --primary: #6366f1; --primary-fg: #ffffff; --primary-soft: #1e2249;
            --danger: #fb7185; --danger-soft: #3a1622;
            --ok: #34d399; --ok-soft: #0d2b22;
            --warn: #fbbf24; --warn-soft: #2e2410;
            --shadow: 0 1px 2px rgba(0,0,0,.3), 0 6px 20px rgba(0,0,0,.35);
            --shadow-hover: 0 2px 6px rgba(0,0,0,.4), 0 16px 36px rgba(0,0,0,.5);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font: 14px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg); color: var(--fg);
            -webkit-font-smoothing: antialiased;
        }
        a { color: var(--primary); text-decoration: none; }
        a:hover { text-decoration: underline; }
        h1 { margin: 0; font-size: 24px; letter-spacing: -.02em; }
        h2 { font-size: 15px; letter-spacing: -.01em; }
        h3 { letter-spacing: -.01em; }

        .layout { display: grid; grid-template-columns: 256px 1fr; min-height: 100vh; }
        .main { padding: 28px 36px; max-width: 1180px; width: 100%; }

        /* Sidebar */
        .sidebar {
            background: var(--card); border-right: 1px solid var(--border);
            padding: 20px 16px; display: flex; flex-direction: column; gap: 6px;
            position: sticky; top: 0; height: 100vh; overflow-y: auto;
        }
        .brand { display: flex; align-items: center; gap: 10px; font-weight: 700;
            font-size: 16px; letter-spacing: -.02em; padding: 4px 8px 12px; color: var(--fg); }
        .brand .logo { font-size: 22px; }
        .sidebar h2 { font-size: 11px; text-transform: uppercase; letter-spacing: .06em;
            color: var(--muted); margin: 18px 8px 8px; font-weight: 600; }
        .sidebar ul { list-style: none; padding: 0; margin: 0; }
        .nav a { display: flex; align-items: center; gap: 10px; padding: 8px 10px;
            border-radius: var(--radius-sm); color: var(--fg); font-weight: 500; transition: background .12s; }
        .nav a:hover { background: var(--primary-soft); color: var(--primary); text-decoration: none; }
        .nav a .ico { width: 18px; text-align: center; opacity: .9; }
        .nav a .count { margin-left: auto; font-size: 11px; font-weight: 600; color: var(--muted);
            background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-pill); padding: 0 7px; }
        .nav a .count.count-danger { color: var(--danger); background: var(--danger-soft); border-color: transparent; }

        .dash-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px;
            border-radius: var(--radius-pill); color: white; font-size: 12px; font-weight: 600;
            box-shadow: var(--shadow); margin: 4px 4px 0; }
        .sidebar-search { position: relative; margin: 12px 0 6px; }
        .sidebar-search-ic { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); font-size: 13px; opacity: .7; pointer-events: none; }
        .sidebar-search input { padding-left: 32px; }
        .feature-list { list-style: none; padding: 0; margin: 4px 0; }
        .feature-list li { display: flex; align-items: center; justify-content: space-between;
            font-size: 12px; color: var(--muted); padding: 3px 8px; }
        .pill { font-size: 11px; font-weight: 600; padding: 1px 8px; border-radius: var(--radius-pill); }
        .pill.on { background: var(--ok-soft); color: var(--ok); }
        .pill.off { background: var(--bg); color: var(--muted); border: 1px solid var(--border); }

        /* Buttons */
        .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px;
            border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--card);
            color: var(--fg); cursor: pointer; font: inherit; font-weight: 600; transition: all .12s; }
        .btn:hover { background: var(--card-2); border-color: var(--muted); text-decoration: none; }
        .btn-primary { background: var(--primary); color: var(--primary-fg); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary); filter: brightness(1.08); }
        .btn-danger { background: transparent; color: var(--danger); border-color: var(--border); }
        .btn-danger:hover { background: var(--danger-soft); border-color: var(--danger); }
        .btn-sm { padding: 5px 11px; font-size: 12.5px; }

        /* Forms */
        .input, textarea, select { width: 100%; padding: 10px 12px; border: 1px solid var(--border);
            border-radius: var(--radius-sm); background: var(--card); color: var(--fg); font: inherit;
            transition: border-color .12s, box-shadow .12s; }
        .input:focus, textarea:focus, select:focus { outline: none; border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-soft); }
        .field { display: block; margin-bottom: 16px; }
        .field > span { display: block; font-weight: 600; margin-bottom: 6px; font-size: 13px; }
        fieldset { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; }
        legend { font-weight: 600; padding: 0 6px; }

        /* Cards */
        .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
            padding: 18px; margin-bottom: 14px; box-shadow: var(--shadow); }
        .cards { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
        .cards .card { margin-bottom: 0; transition: transform .12s, box-shadow .12s; }
        .cards .card:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); }
        .card-form { max-width: 640px; }

        .muted { color: var(--muted); font-size: 12.5px; }
        .tag { display: inline-block; padding: 3px 10px; background: var(--primary-soft); color: var(--primary);
            border-radius: var(--radius-pill); font-size: 11.5px; font-weight: 600; margin: 0 4px 4px 0; }
        .tag:hover { text-decoration: none; filter: brightness(.97); }

        /* Status badges */
        .badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px;
            border-radius: var(--radius-pill); font-size: 11px; font-weight: 600; }
        .badge.pending, .badge.archiving { background: var(--warn-soft); color: var(--warn); }
        .badge.done, .badge.skip { background: var(--ok-soft); color: var(--ok); }
        .badge.failed { background: var(--danger-soft); color: var(--danger); }
        .badge.skip.unsorted, .badge.unsorted { background: var(--card-2); color: var(--muted); border: 1px dashed var(--border); }
        .badge.unreachable { background: var(--warn-soft); color: var(--warn); }

        .field-check { display: flex; flex-direction: row; align-items: center; gap: 8px; }
        .field-check input { width: 16px; height: 16px; }
        .field-hint { margin: -6px 0 4px; font-size: 12px; }

        header.top { display: flex; align-items: center; justify-content: space-between;
            gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
        section + section { margin-top: 32px; }
        .search-bar { display: flex; gap: 8px; margin-bottom: 22px; }
        .search-bar .input { flex: 1; }
        .favicon { width: 16px; height: 16px; vertical-align: middle; margin-right: 6px; border-radius: 3px; }
        .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 3px; vertical-align: middle; }
        .folder-ic { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; font-size: 14px; line-height: 1; vertical-align: middle; border-radius: 6px;
            background: color-mix(in srgb, var(--fic, transparent) 22%, transparent);
            box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fic, transparent) 55%, transparent); }
        .theme-switch { display: flex; gap: 6px; padding: 4px 8px; }
        .theme-switch button { flex: 1; font-size: 16px; padding: 7px 0; border: 1px solid var(--border);
            background: var(--card); border-radius: var(--radius-sm); cursor: pointer; opacity: .55; transition: all .12s; }
        .theme-switch button:hover { opacity: 1; }
        .theme-switch button.active { opacity: 1; border-color: var(--primary); background: var(--primary-soft); }
        form.inline { display: inline; }
        .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        /* Toolbar: uniform button row; forms collapse so buttons align on one baseline */
        .ai-wait-banner { position: fixed; top: 16px; left: 50%; transform: translateX(-50%); z-index: 1000;
            background: var(--primary); color: var(--primary-fg); padding: 12px 22px; border-radius: var(--radius);
            box-shadow: var(--shadow-hover); font-weight: 600; display: none; max-width: 90vw; text-align: center; }
        .flash { padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 18px; border: 1px solid var(--border); font-weight: 500; }
        .flash-error { background: var(--danger-soft); color: var(--danger); border-color: transparent; }
        .flash-success { background: var(--ok-soft); color: var(--ok); border-color: transparent; }
        .toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
        .toolbar > form { display: flex; margin: 0; }
        /* Native <details> dropdown (no JS) used for the merge picker */
        details.menu { position: relative; display: inline-flex; }
        details.menu > summary { list-style: none; cursor: pointer; }
        details.menu > summary::-webkit-details-marker { display: none; }
        details.menu > summary::marker { content: ''; }
        .menu-panel { position: absolute; right: 0; top: calc(100% + 6px); z-index: 30;
            background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm);
            box-shadow: var(--shadow-hover); padding: 12px; min-width: 260px; display: grid; gap: 8px; }

        /* Link cards — compact media-object, mobile-first */
        .link-list { display: grid; grid-template-columns: 1fr; gap: 10px; }
        @media (min-width: 760px) { .link-list { grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 12px; } }

        /* Swipeable folder rows (dashboard): horizontal snap strip. The next card
           is left half-peeking so the swipe affordance is obvious on touch. */
        .link-strip { display: flex; gap: 12px; overflow-x: auto; overflow-y: hidden;
            scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch;
            overscroll-behavior-x: contain; scroll-padding: 0 4px; padding: 4px 4px 14px;
            margin: 0 -4px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
        /* min() keeps a fixed ~340px card where there's room, but shrinks to 84%
           on a narrow phone so the next card peeks (swipe affordance). */
        .link-strip .link-card { flex: 0 0 min(84%, 340px); scroll-snap-align: start; }
        .link-strip::-webkit-scrollbar { height: 8px; }
        .link-strip::-webkit-scrollbar-track { background: transparent; }
        .link-strip::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; }
        .link-strip::-webkit-scrollbar-thumb:hover { background: var(--muted); }

        .link-card { display: flex; gap: 12px; background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 10px; box-shadow: var(--shadow); transition: box-shadow .12s, transform .12s; }
        .link-card:hover { box-shadow: var(--shadow-hover); }
        @media (hover: hover) { .link-card:hover { transform: translateY(-1px); } }

        .link-thumb { flex: none; width: 96px; height: 112px; border-radius: var(--radius-sm); overflow: hidden;
            display: flex; align-items: center; justify-content: center; font-size: 30px; background: var(--card-2); }
        .link-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .link-thumb .link-thumb-fav { width: 34px; height: 34px; border-radius: 7px; box-shadow: var(--shadow); }

        .link-content { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
        .link-title { display: flex; align-items: flex-start; gap: 6px; color: var(--fg); font-weight: 600; line-height: 1.35; }
        .link-title:hover { text-decoration: none; }
        .link-title .favicon { margin-top: 2px; }
        .link-title span { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
        .link-domain { font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .link-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px; max-height: 46px; overflow: hidden; }
        .link-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px 12px;
            flex-wrap: wrap; margin-top: auto; padding-top: 6px; }
        .link-meta { display: flex; align-items: center; gap: 6px; min-width: 0; font-size: 12px; }
        .link-meta .cname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .link-actions { display: flex; gap: 4px; flex: none; }
        .icon-btn { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
            border: 1px solid var(--border); background: var(--card); border-radius: var(--radius-sm); cursor: pointer;
            font-size: 15px; color: var(--fg); transition: all .12s; }
        .icon-btn:hover { background: var(--primary-soft); border-color: var(--primary); text-decoration: none; }
        .icon-btn .ic-svg { display: block; }
        .icon-btn--danger:hover { background: var(--danger-soft); border-color: var(--danger); }

        /* Mobile top bar + off-canvas drawer — all hidden on desktop */
        .app-topbar { display: none; }
        .nav-backdrop { display: none; }
        .sidebar-close { display: none; }
        .nav-toggle { border: 1px solid var(--border); background: var(--card); color: var(--fg);
            border-radius: var(--radius-sm); cursor: pointer; }
        .burger, .burger::before, .burger::after { display: block; width: 20px; height: 2px;
            background: currentColor; border-radius: 2px; }
        .burger { position: relative; }
        .burger::before { content: ''; position: absolute; left: 0; top: -6px; }
        .burger::after { content: ''; position: absolute; left: 0; top: 6px; }

        /* Collapsible sidebar sections */
        details.collapse { margin: 2px 0; }
        details.collapse > summary { display: flex; align-items: center; gap: 8px; padding: 8px 10px;
            border-radius: var(--radius-sm); cursor: pointer; list-style: none; font-weight: 600;
            font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
        details.collapse > summary::-webkit-details-marker { display: none; }
        details.collapse > summary:hover { background: var(--bg); }
        details.collapse > summary .chevron { transition: transform .15s; font-size: 10px; }
        details.collapse[open] > summary .chevron { transform: rotate(90deg); }
        details.collapse > summary .manage { margin-left: auto; color: var(--muted); text-decoration: none; }
        .nav-sub { margin: 2px 0 6px; }
        .nav-sub a { padding: 6px 10px 6px 12px; }
        .nav-sub .label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
        .nav-sub .count { margin-left: auto; font-size: 11px; font-weight: 600; color: var(--muted);
            background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-pill); padding: 0 7px; }
        /* Nested collection tree */
        .nav-sub .nav-sub { margin: 0 0 0 10px; border-left: 1px solid var(--border); padding-left: 2px; }
        details.tree-node { margin: 0; }
        details.tree-node > summary { display: flex; align-items: center; gap: 6px; padding: 6px 10px 6px 4px;
            border-radius: var(--radius-sm); cursor: pointer; list-style: none; text-transform: none;
            letter-spacing: normal; font-weight: 500; font-size: 13.5px; color: var(--fg); }
        details.tree-node > summary::-webkit-details-marker { display: none; }
        details.tree-node > summary:hover { background: var(--primary-soft); }
        details.tree-node > summary .tree-link { display: flex; align-items: center; gap: 8px; flex: 1;
            color: var(--fg); overflow: hidden; }
        details.tree-node > summary .tree-link:hover { text-decoration: none; }
        .tree-leaf { display: flex; align-items: center; gap: 8px; color: var(--fg); }
        .chevron-spacer { width: 10px; flex: none; }
        .nav-more { display: block; padding: 6px 10px 6px 14px; font-size: 12px; font-weight: 600; color: var(--primary); }
        /* Tag cloud (dedicated tags page) */
        .tag-cloud { display: flex; flex-wrap: wrap; gap: 8px; }
        .tag-cloud-item { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px;
            background: var(--primary-soft); color: var(--primary); border-radius: var(--radius-pill);
            font-weight: 600; font-size: 13px; }
        .tag-cloud-item:hover { text-decoration: none; filter: brightness(.97); }
        .tag-count { background: var(--card); color: var(--muted); border-radius: var(--radius-pill);
            padding: 0 7px; font-size: 11px; }
        /* Import folder selection tree */
        .import-tree { list-style: none; margin: 0; padding-left: 18px; border-left: 1px solid var(--border); }
        .import-tree.root, form > .import-tree { border-left: none; padding-left: 0; }
        .import-row { display: flex; align-items: center; gap: 8px; padding: 5px 6px; border-radius: var(--radius-sm); cursor: pointer; }
        .import-row:hover { background: var(--primary-soft); }
        .import-row input { width: 16px; height: 16px; }
        .import-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        /* Root-collection shortcuts shown only in the collapsed rail (see below). */
        .rail-collections { display: none; flex-direction: column; align-items: center; gap: 4px; margin: 2px 0; }
        .rail-col { display: flex; align-items: center; justify-content: center; width: 44px; height: 40px;
            border-radius: var(--radius-sm); }
        .rail-col:hover { background: var(--primary-soft); text-decoration: none; }
        .rail-col .swatch { width: 22px; height: 22px; border-radius: 7px; box-shadow: var(--shadow); }
        .rail-col .folder-ic { width: 30px; height: 30px; font-size: 18px; border-radius: 9px; }
        .rail-col-add { color: var(--muted); font-size: 16px; }

        /* Auto icon-rail: below 1024px the sidebar collapses to icons and expands to a
           flyout on hover. Pure CSS, width-driven — no JS, no class. Hides scoped to
           :not(:hover) so hovering restores the original styles. */
        @media (max-width: 1024px) {
            /* Rail is position:fixed (not a grid track) so the expanded panel overlays
               content cleanly. Collapse/expand is toggled by a CLICK on the brand
               (html.rail-open), not hover — hover proved too twitchy. Content clears
               the collapsed rail with a left margin equal to its width. */
            .layout { display: block; }
            .main { margin-left: 72px; width: auto; padding: 22px 20px; }
            .sidebar { position: fixed; top: 0; left: 0; height: 100vh; width: 72px; z-index: 40;
                white-space: nowrap; overflow: hidden; transition: width .18s ease, box-shadow .18s ease; }
            .sidebar .brand { cursor: pointer; }

            /* Expanded (clicked open) */
            .rail-open .sidebar { width: 264px; z-index: 60; box-shadow: var(--shadow-hover);
                white-space: normal; overflow-y: auto; }

            /* Collapsed (default): hide text chrome, show root-collection icon shortcuts */
            html:not(.rail-open) .sidebar .switch-form,
            html:not(.rail-open) .sidebar .dash-badge,
            html:not(.rail-open) .sidebar .sidebar-search,
            html:not(.rail-open) .sidebar > h2,
            html:not(.rail-open) .sidebar .feature-list,
            html:not(.rail-open) .sidebar .theme-switch,
            html:not(.rail-open) .sidebar .manage,
            html:not(.rail-open) .sidebar .chevron,
            html:not(.rail-open) .sidebar .nav-sub,
            html:not(.rail-open) .sidebar .nav-more,
            html:not(.rail-open) .sidebar #col-collections { display: none; }

            html:not(.rail-open) .sidebar .rail-collections { display: flex; }

            html:not(.rail-open) .sidebar .brand { font-size: 0; justify-content: center; padding: 4px 0 12px; }
            html:not(.rail-open) .sidebar .brand .logo { font-size: 22px; }
            html:not(.rail-open) .sidebar .nav a,
            html:not(.rail-open) .sidebar details.collapse > summary { font-size: 0; justify-content: center; padding: 10px 0; gap: 0; }
            html:not(.rail-open) .sidebar .nav a .ico,
            html:not(.rail-open) .sidebar details.collapse > summary .ico { font-size: 18px; }
        }

        @media (prefers-reduced-motion: reduce) {
            .sidebar, .nav-backdrop { transition: none; }
        }
    </style>
</head>
<body>
<header class="app-topbar">
    <button type="button" class="nav-toggle" aria-controls="sidebar" aria-expanded="false"
            aria-label="{{ 'nav.open_menu'|trans }}"><span class="burger" aria-hidden="true"></span></button>
    <span class="brand-text"><span class="logo">🔖</span> {{ 'app.name'|trans }}</span>
</header>
<div class="nav-backdrop" data-nav-close></div>
<div class="layout">
    {% include 'layout/_sidebar.html.twig' %}
    <main class="main">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ type }}">{{ (message starts with 'collection.') or (message starts with 'link.') ? message|trans : message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
</div>
<script>
    // Track clicks on bookmark links without changing their real href (copy/middle-click keep working).
    document.addEventListener('click', function (e) {
        var a = e.target.closest('a[data-click-id]');
        if (a && navigator.sendBeacon) {
            navigator.sendBeacon(window.APP_BASE + '/links/' + a.dataset.clickId + '/click');
        }
    }, true);

    // Long-running AI forms: on submit, disable the button and show a wait banner.
    document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form.classList || !form.classList.contains('js-ai-wait')) { return; }
        var btn = form.querySelector('button[type="submit"], button:not([type])');
        if (btn) {
            if (btn.dataset.waitLabel) { btn.textContent = btn.dataset.waitLabel; }
            setTimeout(function () { btn.disabled = true; }, 0);
        }
        var banner = document.getElementById('ai-wait-banner');
        if (!banner) {
            banner = document.createElement('div');
            banner.id = 'ai-wait-banner';
            banner.className = 'ai-wait-banner';
            document.body.appendChild(banner);
        }
        banner.textContent = form.dataset.waitMsg || '⏳';
        banner.style.display = 'block';
    }, true);

    // Off-canvas sidebar drawer (mobile).
    (function () {
        var body = document.body, toggle = document.querySelector('.nav-toggle');
        function setNav(open) {
            body.classList.toggle('nav-open', open);
            if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        if (toggle) toggle.addEventListener('click', function () { setNav(!body.classList.contains('nav-open')); });
        document.querySelectorAll('[data-nav-close]').forEach(function (el) {
            el.addEventListener('click', function () { setNav(false); });
        });
        var sidebar = document.getElementById('sidebar');
        if (sidebar) sidebar.addEventListener('click', function (e) { if (e.target.closest('a')) setNav(false); });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && body.classList.contains('nav-open')) setNav(false);
        });
    })();
</script>
</body>
</html>
