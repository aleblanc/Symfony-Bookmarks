<!doctype html>
<html lang="{{ app.request.locale|default('fr') }}" data-theme="sepia">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
    <script>(function(){var t=localStorage.getItem('theme');if(t){document.documentElement.dataset.theme=t;}})();</script>
    <style>
        :root {
            --radius: 12px; --radius-sm: 8px; --radius-pill: 999px;
            --space: 20px;
        }
        /* Day */
        [data-theme="light"] {
            --bg: #f5f7fb; --fg: #0f172a; --muted: #64748b; --border: #e6eaf1;
            --card: #ffffff; --card-2: #fbfcfe;
            --primary: #4f46e5; --primary-fg: #ffffff; --primary-soft: #eef2ff;
            --danger: #e11d48; --danger-soft: #fff1f3;
            --ok: #059669; --ok-soft: #ecfdf5;
            --warn: #d97706; --warn-soft: #fffbeb;
            --shadow: 0 1px 2px rgba(15,23,42,.04), 0 4px 16px rgba(15,23,42,.06);
            --shadow-hover: 0 2px 4px rgba(15,23,42,.06), 0 12px 28px rgba(15,23,42,.10);
        }
        /* Sepia (default) */
        [data-theme="sepia"] {
            --bg: #f1e7d0; --fg: #4a3a29; --muted: #8a7355; --border: #e0d0ac;
            --card: #faf2df; --card-2: #f3e8cd;
            --primary: #9a5a2b; --primary-fg: #fdf6ea; --primary-soft: #ecdcbf;
            --danger: #b4442f; --danger-soft: #f3ddce;
            --ok: #5c7a3a; --ok-soft: #e6ecd2;
            --warn: #a9741f; --warn-soft: #f0e4c6;
            --shadow: 0 1px 2px rgba(74,58,41,.06), 0 4px 16px rgba(74,58,41,.10);
            --shadow-hover: 0 2px 4px rgba(74,58,41,.10), 0 12px 28px rgba(74,58,41,.16);
        }
        /* Night */
        [data-theme="dark"] {
            --bg: #0b1120; --fg: #e8edf6; --muted: #94a3b8; --border: #1e293b;
            --card: #131c2e; --card-2: #0f1728;
            --primary: #6366f1; --primary-fg: #ffffff; --primary-soft: #1e2249;
            --danger: #fb7185; --danger-soft: #3a1622;
            --ok: #34d399; --ok-soft: #0d2b22;
            --warn: #fbbf24; --warn-soft: #2e2410;
            --shadow: 0 1px 2px rgba(0,0,0,.3), 0 6px 20px rgba(0,0,0,.35);
            --shadow-hover: 0 2px 6px rgba(0,0,0,.4), 0 16px 36px rgba(0,0,0,.5);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font: 14px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg); color: var(--fg);
            -webkit-font-smoothing: antialiased;
        }
        a { color: var(--primary); text-decoration: none; }
        a:hover { text-decoration: underline; }
        h1 { margin: 0; font-size: 24px; letter-spacing: -.02em; }
        h2 { font-size: 15px; letter-spacing: -.01em; }
        h3 { letter-spacing: -.01em; }

        .layout { display: grid; grid-template-columns: 256px 1fr; min-height: 100vh; }
        .main { padding: 28px 36px; max-width: 1180px; width: 100%; }

        /* Sidebar */
        .sidebar {
            background: var(--card); border-right: 1px solid var(--border);
            padding: 20px 16px; display: flex; flex-direction: column; gap: 6px;
            position: sticky; top: 0; height: 100vh; overflow-y: auto;
        }
        .brand { display: flex; align-items: center; gap: 10px; font-weight: 700;
            font-size: 16px; letter-spacing: -.02em; padding: 4px 8px 12px; color: var(--fg); }
        .brand .logo { font-size: 22px; }
        .sidebar h2 { font-size: 11px; text-transform: uppercase; letter-spacing: .06em;
            color: var(--muted); margin: 18px 8px 8px; font-weight: 600; }
        .sidebar ul { list-style: none; padding: 0; margin: 0; }
        .nav a { display: flex; align-items: center; gap: 10px; padding: 8px 10px;
            border-radius: var(--radius-sm); color: var(--fg); font-weight: 500; transition: background .12s; }
        .nav a:hover { background: var(--primary-soft); color: var(--primary); text-decoration: none; }
        .nav a .ico { width: 18px; text-align: center; opacity: .9; }

        .dash-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px;
            border-radius: var(--radius-pill); color: white; font-size: 12px; font-weight: 600;
            box-shadow: var(--shadow); margin: 4px 4px 0; }
        .feature-list { list-style: none; padding: 0; margin: 4px 0; }
        .feature-list li { display: flex; align-items: center; justify-content: space-between;
            font-size: 12px; color: var(--muted); padding: 3px 8px; }
        .pill { font-size: 11px; font-weight: 600; padding: 1px 8px; border-radius: var(--radius-pill); }
        .pill.on { background: var(--ok-soft); color: var(--ok); }
        .pill.off { background: var(--bg); color: var(--muted); border: 1px solid var(--border); }

        /* Buttons */
        .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px;
            border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--card);
            color: var(--fg); cursor: pointer; font: inherit; font-weight: 600; transition: all .12s; }
        .btn:hover { background: var(--card-2); border-color: var(--muted); text-decoration: none; }
        .btn-primary { background: var(--primary); color: var(--primary-fg); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary); filter: brightness(1.08); }
        .btn-danger { background: transparent; color: var(--danger); border-color: var(--border); }
        .btn-danger:hover { background: var(--danger-soft); border-color: var(--danger); }
        .btn-sm { padding: 5px 11px; font-size: 12.5px; }

        /* Forms */
        .input, textarea, select { width: 100%; padding: 10px 12px; border: 1px solid var(--border);
            border-radius: var(--radius-sm); background: var(--card); color: var(--fg); font: inherit;
            transition: border-color .12s, box-shadow .12s; }
        .input:focus, textarea:focus, select:focus { outline: none; border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-soft); }
        .field { display: block; margin-bottom: 16px; }
        .field > span { display: block; font-weight: 600; margin-bottom: 6px; font-size: 13px; }
        fieldset { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; }
        legend { font-weight: 600; padding: 0 6px; }

        /* Cards */
        .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
            padding: 18px; margin-bottom: 14px; box-shadow: var(--shadow); }
        .cards { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
        .cards .card { margin-bottom: 0; transition: transform .12s, box-shadow .12s; }
        .cards .card:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); }
        .card-form { max-width: 640px; }

        .muted { color: var(--muted); font-size: 12.5px; }
        .tag { display: inline-block; padding: 3px 10px; background: var(--primary-soft); color: var(--primary);
            border-radius: var(--radius-pill); font-size: 11.5px; font-weight: 600; margin: 0 4px 4px 0; }
        .tag:hover { text-decoration: none; filter: brightness(.97); }

        /* Status badges */
        .badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px;
            border-radius: var(--radius-pill); font-size: 11px; font-weight: 600; }
        .badge.pending, .badge.archiving { background: var(--warn-soft); color: var(--warn); }
        .badge.done, .badge.skip { background: var(--ok-soft); color: var(--ok); }
        .badge.failed { background: var(--danger-soft); color: var(--danger); }

        header.top { display: flex; align-items: center; justify-content: space-between;
            gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
        section + section { margin-top: 32px; }
        .search-bar { display: flex; gap: 8px; margin-bottom: 22px; }
        .search-bar .input { flex: 1; }
        .favicon { width: 16px; height: 16px; vertical-align: middle; margin-right: 6px; border-radius: 3px; }
        .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 3px; vertical-align: middle; }
        .folder-ic { display: inline-block; width: 18px; text-align: center; font-size: 15px; line-height: 1; vertical-align: middle; }
        .theme-switch { display: flex; gap: 6px; padding: 4px 8px; }
        .theme-switch button { flex: 1; font-size: 16px; padding: 7px 0; border: 1px solid var(--border);
            background: var(--card); border-radius: var(--radius-sm); cursor: pointer; opacity: .55; transition: all .12s; }
        .theme-switch button:hover { opacity: 1; }
        .theme-switch button.active { opacity: 1; border-color: var(--primary); background: var(--primary-soft); }
        form.inline { display: inline; }
        .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

        /* Link cards — compact media-object, mobile-first */
        .link-list { display: grid; grid-template-columns: 1fr; gap: 10px; }
        @media (min-width: 760px) { .link-list { grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 12px; } }

        .link-card { display: flex; gap: 12px; background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 10px; box-shadow: var(--shadow); transition: box-shadow .12s, transform .12s; }
        .link-card:hover { box-shadow: var(--shadow-hover); }
        @media (hover: hover) { .link-card:hover { transform: translateY(-1px); } }

        .link-thumb { flex: none; width: 96px; height: 112px; border-radius: var(--radius-sm); overflow: hidden;
            display: flex; align-items: center; justify-content: center; font-size: 30px; background: var(--card-2); }
        .link-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .link-thumb .link-thumb-fav { width: 34px; height: 34px; border-radius: 7px; box-shadow: var(--shadow); }

        .link-content { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
        .link-title { display: flex; align-items: flex-start; gap: 6px; color: var(--fg); font-weight: 600; line-height: 1.35; }
        .link-title:hover { text-decoration: none; }
        .link-title .favicon { margin-top: 2px; }
        .link-title span { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
        .link-domain { font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .link-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px; max-height: 46px; overflow: hidden; }
        .link-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 6px; }
        .link-meta { display: flex; align-items: center; gap: 6px; min-width: 0; font-size: 12px; }
        .link-meta .cname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .link-actions { display: flex; gap: 4px; flex: none; }
        .icon-btn { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
            border: 1px solid var(--border); background: var(--card); border-radius: var(--radius-sm); cursor: pointer;
            font-size: 15px; color: var(--fg); transition: all .12s; }
        .icon-btn:hover { background: var(--primary-soft); border-color: var(--primary); text-decoration: none; }
        .icon-btn--danger:hover { background: var(--danger-soft); border-color: var(--danger); }

        /* Collapsible sidebar sections */
        details.collapse { margin: 2px 0; }
        details.collapse > summary { display: flex; align-items: center; gap: 8px; padding: 8px 10px;
            border-radius: var(--radius-sm); cursor: pointer; list-style: none; font-weight: 600;
            font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
        details.collapse > summary::-webkit-details-marker { display: none; }
        details.collapse > summary:hover { background: var(--bg); }
        details.collapse > summary .chevron { transition: transform .15s; font-size: 10px; }
        details.collapse[open] > summary .chevron { transform: rotate(90deg); }
        details.collapse > summary .manage { margin-left: auto; color: var(--muted); text-decoration: none; }
        .nav-sub { margin: 2px 0 6px; }
        .nav-sub a { padding: 6px 10px 6px 12px; }
        .nav-sub .label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
        .nav-sub .count { margin-left: auto; font-size: 11px; font-weight: 600; color: var(--muted);
            background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-pill); padding: 0 7px; }
        /* Nested collection tree */
        .nav-sub .nav-sub { margin: 0 0 0 10px; border-left: 1px solid var(--border); padding-left: 2px; }
        details.tree-node { margin: 0; }
        details.tree-node > summary { display: flex; align-items: center; gap: 6px; padding: 6px 10px 6px 4px;
            border-radius: var(--radius-sm); cursor: pointer; list-style: none; text-transform: none;
            letter-spacing: normal; font-weight: 500; font-size: 13.5px; color: var(--fg); }
        details.tree-node > summary::-webkit-details-marker { display: none; }
        details.tree-node > summary:hover { background: var(--primary-soft); }
        details.tree-node > summary .tree-link { display: flex; align-items: center; gap: 8px; flex: 1;
            color: var(--fg); overflow: hidden; }
        details.tree-node > summary .tree-link:hover { text-decoration: none; }
        .tree-leaf { display: flex; align-items: center; gap: 8px; color: var(--fg); }
        .chevron-spacer { width: 10px; flex: none; }
        /* Import folder selection tree */
        .import-tree { list-style: none; margin: 0; padding-left: 18px; border-left: 1px solid var(--border); }
        .import-tree.root, form > .import-tree { border-left: none; padding-left: 0; }
        .import-row { display: flex; align-items: center; gap: 8px; padding: 5px 6px; border-radius: var(--radius-sm); cursor: pointer; }
        .import-row:hover { background: var(--primary-soft); }
        .import-row input { width: 16px; height: 16px; }
        .import-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        @media (max-width: 780px) {
            .layout { grid-template-columns: 1fr; }
            .sidebar { position: static; height: auto; border-right: none; border-bottom: 1px solid var(--border); }
            .main { padding: 20px 18px; }
        }
    </style>
</head>
<body>
<div class="layout">
    {% include 'layout/_sidebar.html.twig' %}
    <main class="main">
        {% block body %}{% endblock %}
    </main>
</div>
</body>
</html>
