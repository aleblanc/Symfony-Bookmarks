{%- apply spaceless -%}
{
    "name": "Symfony Bookmarks",
    "short_name": {{ 'app.name'|trans|json_encode|raw }},
    "description": "Self-hosted, single-user bookmark manager.",
    "lang": "fr",
    "dir": "ltr",
    "start_url": {{ (app.request.basePath ~ '/')|json_encode|raw }},
    "scope": {{ (app.request.basePath ~ '/')|json_encode|raw }},
    "id": {{ (app.request.basePath ~ '/')|json_encode|raw }},
    "display": "standalone",
    "orientation": "any",
    "background_color": "#fbf7f0",
    "theme_color": "#e11d48",
    "icons": [
        { "src": {{ asset('favicon.svg')|json_encode|raw }}, "type": "image/svg+xml", "sizes": "16x16 32x32 48x48 64x64 96x96 128x128 192x192 256x256 384x384 512x512" },
        { "src": {{ asset('icon-192.png')|json_encode|raw }}, "type": "image/png", "sizes": "192x192" },
        { "src": {{ asset('icon-512.png')|json_encode|raw }}, "type": "image/png", "sizes": "512x512" },
        { "src": {{ asset('icon-maskable.svg')|json_encode|raw }}, "type": "image/svg+xml", "sizes": "192x192 256x256 384x384 512x512", "purpose": "maskable" },
        { "src": {{ asset('icon-maskable-192.png')|json_encode|raw }}, "type": "image/png", "sizes": "192x192", "purpose": "maskable" },
        { "src": {{ asset('icon-maskable-512.png')|json_encode|raw }}, "type": "image/png", "sizes": "512x512", "purpose": "maskable" }
    ]
}
{%- endapply -%}
