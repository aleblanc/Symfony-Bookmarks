{% extends 'base.html.twig' %}
{% block title %}Unlock vault{% endblock %}
{% block body %}
    <h1>Unlock vault "{{ vault.name }}"</h1>
    {% if error %}<div class="card" style="border-color: var(--danger);"><p>{{ error }}</p></div>{% endif %}
    <form method="post" class="card" style="max-width: 400px;">
        <label>Password<br><input class="input" type="password" name="password" required autofocus></label><br><br>
        <button class="btn btn-primary" type="submit">Unlock (15 min)</button>
    </form>
{% endblock %}
