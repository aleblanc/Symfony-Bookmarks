{% extends 'base.html.twig' %}
{% block title %}{{ 'nav.notes'|trans }}{% endblock %}
{% block body %}
    <header class="top">
        <h1>🗒️ {{ 'nav.notes'|trans }}</h1>
    </header>

    <style>
        .note-edit textarea { width: 100%; min-height: 65vh;
            font: 14px/1.6 ui-monospace, "SF Mono", Menlo, Consolas, monospace; resize: vertical; }
        .note-edit .row { display: flex; gap: 10px; margin-top: 12px; }
    </style>

    <form class="note-edit" method="post" action="{{ path('notes_save') }}">
        <textarea name="content" class="input" autofocus>{{ raw }}</textarea>
        <div class="row">
            <button class="btn btn-primary" type="submit">💾 {{ 'common.save'|trans }}</button>
        </div>
    </form>
{% endblock %}
