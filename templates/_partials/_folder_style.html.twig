    var grid = document.getElementById('icon-grid');
    var search = document.getElementById('icon-search');
    var preview = document.getElementById('icon-preview');
    var value = document.getElementById('icon-value');
    function render(q) {
        q = (q || '').toLowerCase().trim();
        grid.innerHTML = '';
        ICONS.filter(function (i) { return !q || i[1].indexOf(q) !== -1 || i[0] === q; }).forEach(function (i) {
            var b = document.createElement('button');
            b.type = 'button'; b.textContent = i[0]; b.title = i[1];
            b.addEventListener('click', function () { value.value = i[0]; preview.textContent = i[0]; });
