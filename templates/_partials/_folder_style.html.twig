    var hex = document.getElementById('color-hex');
    var native = document.getElementById('color-native');
    document.querySelectorAll('.swatch-btn').forEach(function (b) {
        b.addEventListener('click', function () { hex.value = b.dataset.color; native.value = b.dataset.color; });
    });
    native.addEventListener('input', function () { hex.value = native.value; });
    hex.addEventListener('input', function () { if (/^#[0-9a-fA-F]{6}$/.test(hex.value)) native.value = hex.value; });

    var ICONS = [
