{# Colour + emoji-icon picker for a folder. Include with current_color / current_icon. #}
{% set cur_color = current_color|default('#0ea5e9') %}
{% set cur_icon = current_icon|default('') %}
{% set cur_icon = cur_icon in ['', 'BM'] ? '📁' : cur_icon %}

<div class="field">
    <span>{{ 'collection.field_color'|trans }}</span>
    <div class="color-picker">
        <div class="swatches">
            {% for c in ['#0ea5e9','#6366f1','#8b5cf6','#ec4899','#ef4444','#f97316','#f59e0b','#10b981','#14b8a6','#64748b','#0f172a','#e11d48'] %}
                <button type="button" class="swatch-btn" data-color="{{ c }}" style="background:{{ c }};" title="{{ c }}"></button>
            {% endfor %}
        </div>
        <input type="color" id="color-native" value="{{ cur_color }}" aria-label="{{ 'collection.field_color'|trans }}">
        <input class="input" type="text" name="color" id="color-hex" value="{{ cur_color }}" style="max-width:120px;">
    </div>
</div>

<div class="field">
    <span>{{ 'collection.field_icon'|trans }}</span>
    <div class="icon-picker">
        <span class="icon-preview" id="icon-preview">{{ cur_icon }}</span>
        <input type="hidden" name="icon" id="icon-value" value="{{ cur_icon }}">
        <input class="input" type="search" id="icon-search" placeholder="{{ 'collection.icon_search'|trans }}" autocomplete="off">
    </div>
    <div class="icon-grid" id="icon-grid"></div>
</div>

<style>
    .color-picker { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .swatches { display:flex; gap:6px; flex-wrap:wrap; }
    .swatch-btn { width:24px; height:24px; border-radius:6px; border:2px solid var(--card); box-shadow:0 0 0 1px var(--border); cursor:pointer; padding:0; }
    .swatch-btn:hover { transform:scale(1.1); }
    #color-native { width:38px; height:34px; padding:0; border:1px solid var(--border); border-radius:8px; background:var(--card); cursor:pointer; }
    .icon-picker { display:flex; align-items:center; gap:10px; }
    .icon-preview { font-size:26px; width:44px; height:44px; display:flex; align-items:center; justify-content:center;
        border:1px solid var(--border); border-radius:10px; background:var(--card); }
    .icon-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(40px,1fr)); gap:4px; margin-top:10px;
        max-height:180px; overflow-y:auto; border:1px solid var(--border); border-radius:10px; padding:8px; background:var(--card-2); }
    .icon-grid button { font-size:20px; padding:6px; border:none; background:transparent; border-radius:8px; cursor:pointer; }
    .icon-grid button:hover { background:var(--primary-soft); }
</style>

<script>
