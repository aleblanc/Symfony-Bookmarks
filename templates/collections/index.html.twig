{% extends 'base.html.twig' %}
{% import '_partials/_folder_icon.html.twig' as fi %}
{% block title %}{{ 'collection.title_plural'|trans }}{% endblock %}
{% block body %}
    <header class="top">
        <h1>{{ 'collection.title_plural'|trans }}</h1>
        <a href="{{ path('collections_new') }}" class="btn btn-primary">➕ {{ 'collection.new'|trans }}</a>
    </header>
    {% if tree is empty %}
        <p class="muted">{{ 'collection.none'|trans }}</p>
    {% else %}
        <div class="cards">
            {% for node in tree %}
                <article class="card">
                    <h3 style="margin: 0 0 6px;">
                        <a href="{{ path('collections_show', {id: node.collection.id}) }}">
                            {{ fi.icon(node.collection) }} {{ node.collection.name }}
                        </a>
                    </h3>
                    {% if node.collection.description %}<p class="muted">{{ node.collection.description }}</p>{% endif %}
                    <p class="muted" style="margin:6px 0 0;">
                        {{ 'collection.link_count'|trans({'%count%': node.count}) }}
                        {% if node.children is not empty %} · {{ 'collection.subfolder_count'|trans({'%count%': node.children|length}) }}{% endif %}
                    </p>
                    <div class="row" style="margin-top: 12px;">
                        <a class="btn btn-sm" href="{{ path('collections_show', {id: node.collection.id}) }}">{{ 'common.open'|trans }}</a>
                        <a class="btn btn-sm" href="{{ path('collections_new', {parent: node.collection.id}) }}">➕ {{ 'collection.new_subfolder'|trans }}</a>
                        <span class="spacer" style="flex:1;"></span>
                        <form class="inline" method="post" action="{{ path('collections_move', {id: node.collection.id}) }}"><input type="hidden" name="direction" value="top"><button class="btn btn-sm" type="submit" title="{{ 'collection.move_top'|trans }}" aria-label="{{ 'collection.move_top'|trans }}">⏫</button></form>
                        <form class="inline" method="post" action="{{ path('collections_move', {id: node.collection.id}) }}"><input type="hidden" name="direction" value="up"><button class="btn btn-sm" type="submit" title="{{ 'collection.move_up'|trans }}" aria-label="{{ 'collection.move_up'|trans }}">↑</button></form>
                        <form class="inline" method="post" action="{{ path('collections_move', {id: node.collection.id}) }}"><input type="hidden" name="direction" value="down"><button class="btn btn-sm" type="submit" title="{{ 'collection.move_down'|trans }}" aria-label="{{ 'collection.move_down'|trans }}">↓</button></form>
                        <form class="inline" method="post" action="{{ path('collections_move', {id: node.collection.id}) }}"><input type="hidden" name="direction" value="bottom"><button class="btn btn-sm" type="submit" title="{{ 'collection.move_bottom'|trans }}" aria-label="{{ 'collection.move_bottom'|trans }}">⏬</button></form>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
