{% extends 'base.html.twig' %}
{% block title %}{{ 'collection.title_plural'|trans }}{% endblock %}
{% block body %}
    <header class="top">
        <h1>{{ 'collection.title_plural'|trans }}</h1>
        <a href="{{ path('collections_new') }}" class="btn btn-primary">➕ {{ 'collection.new'|trans }}</a>
    </header>
    {% if collections is empty %}
        <p class="muted">{{ 'collection.none'|trans }}</p>
    {% else %}
        <div class="cards">
            {% for c in collections %}
                <article class="card">
                    <h3 style="margin: 0 0 6px;"><span class="swatch" style="background:{{ c.color }};"></span> {{ c.name }}</h3>
                    {% if c.description %}<p class="muted">{{ c.description }}</p>{% endif %}
                    <div class="row" style="margin-top: 12px;">
                        <a class="btn btn-sm" href="{{ path('links_index', {collection: c.id}) }}">{{ 'collection.view_links'|trans }}</a>
                        <form class="inline" method="post" action="{{ path('collections_delete', {id: c.id}) }}" onsubmit="return confirm('{{ 'collection.confirm_delete'|trans }}');">
                            <button class="btn btn-sm btn-danger" type="submit">{{ 'common.delete'|trans }}</button>
                        </form>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
