{% extends 'base.html.twig' %}
{% import '_partials/_folder_icon.html.twig' as fi %}
{% block title %}{{ collection.name }}{% endblock %}
{% block body %}
    <nav class="breadcrumb muted">
        <a href="{{ path('collections_index') }}">{{ 'collection.title_plural'|trans }}</a>
        {% for ancestor in collection.ancestors %}
            <span>/</span> <a href="{{ path('collections_show', {id: ancestor.id}) }}">{{ ancestor.name }}</a>
        {% endfor %}
        <span>/</span> <strong>{{ collection.name }}</strong>
    </nav>

    <header class="top">
        <h1>{{ fi.icon(collection) }} {{ collection.name }}</h1>
        <div class="row">
            <a href="{{ path('collections_edit', {id: collection.id}) }}" class="btn">✏️ {{ 'collection.edit'|trans }}</a>
            <a href="{{ path('collections_new', {parent: collection.id}) }}" class="btn">➕ {{ 'collection.new_subfolder'|trans }}</a>
            <a href="{{ path('links_new', {collection: collection.id}) }}" class="btn btn-primary">➕ {{ 'link.new'|trans }}</a>
        </div>
    </header>
    {% if collection.description %}<p class="muted">{{ collection.description }}</p>{% endif %}

    {% if children is not empty %}
        <section>
            <h2>{{ 'collection.subfolders'|trans }}</h2>
            <div class="cards">
                {% for child in children %}
                    <article class="card">
                        <h3 style="margin:0;">
                            <a href="{{ path('collections_show', {id: child.id}) }}">
                                {{ fi.icon(child) }} {{ child.name }}
                            </a>
                        </h3>
                        {% if child.description %}<p class="muted" style="margin:6px 0 0;">{{ child.description }}</p>{% endif %}
                        <div class="row" style="margin-top:10px;">
                            <form class="inline" method="post" action="{{ path('collections_move', {id: child.id}) }}"><input type="hidden" name="direction" value="top"><button class="btn btn-sm" type="submit" title="{{ 'collection.move_top'|trans }}" aria-label="{{ 'collection.move_top'|trans }}">⏫</button></form>
                            <form class="inline" method="post" action="{{ path('collections_move', {id: child.id}) }}"><input type="hidden" name="direction" value="up"><button class="btn btn-sm" type="submit" title="{{ 'collection.move_up'|trans }}" aria-label="{{ 'collection.move_up'|trans }}">↑</button></form>
                            <form class="inline" method="post" action="{{ path('collections_move', {id: child.id}) }}"><input type="hidden" name="direction" value="down"><button class="btn btn-sm" type="submit" title="{{ 'collection.move_down'|trans }}" aria-label="{{ 'collection.move_down'|trans }}">↓</button></form>
                            <form class="inline" method="post" action="{{ path('collections_move', {id: child.id}) }}"><input type="hidden" name="direction" value="bottom"><button class="btn btn-sm" type="submit" title="{{ 'collection.move_bottom'|trans }}" aria-label="{{ 'collection.move_bottom'|trans }}">⏬</button></form>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section>
        <h2>{{ 'collection.links_in'|trans }}</h2>
        {% if links is empty %}
            <p class="muted">{{ 'link.none_match'|trans }}</p>
        {% else %}
            <div class="link-list">
                {% for link in links %}{% include 'links/_card.html.twig' %}{% endfor %}
            </div>
        {% endif %}
    </section>

    <div class="row" style="margin-top:24px; gap:16px;">
        {% if merge_targets is not empty %}
            <form class="row" method="post" action="{{ path('collections_merge', {id: collection.id}) }}"
                  onsubmit="return confirm('{{ 'collection.confirm_merge'|trans }}');">
                <select class="input" name="target" required style="max-width:280px;">
                    <option value="">— {{ 'collection.merge_into'|trans }} —</option>
                    {% for c in merge_targets %}<option value="{{ c.id }}">{% for a in c.ancestors %}{{ a.name }} / {% endfor %}{{ c.name }}</option>{% endfor %}
                </select>
                <button class="btn btn-sm" type="submit">🔀 {{ 'collection.merge'|trans }}</button>
            </form>
        {% endif %}
        {% if ai_enabled and links is not empty %}
            <form class="inline" method="post" action="{{ path('collections_organize', {id: collection.id}) }}">
                <button class="btn btn-sm" type="submit" title="{{ 'collection.organize'|trans }}">🪄🤖 {{ 'collection.organize'|trans }}</button>
            </form>
        {% endif %}
        <form class="inline" method="post" action="{{ path('collections_delete', {id: collection.id}) }}" onsubmit="return confirm('{{ 'collection.confirm_delete'|trans }}');">
            <button class="btn btn-sm btn-danger" type="submit">{{ 'common.delete'|trans }}</button>
        </form>
    </div>
{% endblock %}
