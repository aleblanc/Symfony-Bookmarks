{% extends 'base.html.twig' %}
{% block title %}New collection{% endblock %}
{% block body %}
    <h1>New collection</h1>
    <form method="post" class="card" style="max-width: 640px;">
        <label>Name<br><input class="input" type="text" name="name" required autofocus></label><br><br>
        <label>Description (optional)<br><textarea class="input" name="description" rows="3"></textarea></label><br><br>
        <label>Color (hex)<br><input class="input" type="text" name="color" value="#0ea5e9"></label><br><br>
        <button class="btn btn-primary" type="submit">Create</button>
    </form>
{% endblock %}
