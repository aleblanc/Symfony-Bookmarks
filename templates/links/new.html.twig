{% extends 'base.html.twig' %}
{% block title %}{{ 'link.new'|trans }}{% endblock %}
{% block body %}
    <header class="top"><h1>{{ 'link.new'|trans }}</h1></header>
    {% if collections is empty %}
        <div class="card card-form">
            <p>{{ 'link.need_collection'|trans }} <a href="{{ path('collections_new') }}">{{ 'link.create_one'|trans }}</a>.</p>
        </div>
    {% else %}
        <form method="post" class="card card-form">
            <label class="field"><span>{{ 'link.field_url'|trans }}</span>
                <input class="input" type="url" name="url" required autofocus></label>
            <label class="field"><span>{{ 'link.field_name'|trans }}</span>
                <input class="input" type="text" name="name"></label>
            <label class="field"><span>{{ 'link.field_collection'|trans }}</span>
                <select class="input" name="collection" required>
                    {% for c in collections %}<option value="{{ c.id }}" {{ preselect is defined and preselect == c.id ? 'selected' : '' }}>{% for a in c.ancestors %}{{ a.name }} / {% endfor %}{{ c.name }}</option>{% endfor %}
                </select>
            </label>
            {% set feat = archive_features() %}
            <fieldset style="margin-bottom:16px;">
                <legend>{{ 'link.archiving_legend'|trans }}</legend>
                <p class="muted" style="margin:4px 0 8px;">{{ 'link.archiving_intro'|trans }}</p>
                <ul class="feature-list" style="font-size:13px;">
                    <li>{{ (feat.singlefile ? 'link.feature_singlefile_on' : 'link.feature_singlefile_off')|trans }}</li>
                    <li>{{ (feat.screenshot ? 'link.feature_screenshot_on' : 'link.feature_screenshot_off')|trans }}</li>
                    <li>{{ (feat.pdf ? 'link.feature_pdf_on' : 'link.feature_pdf_off')|trans }}</li>
                </ul>
            </fieldset>
            <button class="btn btn-primary" type="submit">➕ {{ 'link.submit'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
