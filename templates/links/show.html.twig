{% extends 'base.html.twig' %}
{% block title %}{{ link.name ?: link.url }}{% endblock %}
{% block body %}
    <header class="top"><h1>{{ link.name ?: 'link.untitled'|trans }}</h1></header>
    <p><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.url }}</a></p>
    <p class="row muted">
        <span><span class="swatch" style="background: {{ link.collection.color }};"></span> {{ 'link.collection_label'|trans }}: {{ link.collection.name }}</span>
        {% if link.collection.skipProcessing %}
            <span class="badge unsorted">{{ 'status.value.unsorted'|trans }}</span>
        {% else %}
            <span class="badge {{ link.status }}">{{ ('status.value.' ~ link.status)|trans }}</span>
            <span class="badge {{ link.aiStatus }}">{{ 'status.ai_label'|trans }}: {{ ('status.value.' ~ link.aiStatus)|trans }}</span>
        {% endif %}
        <span>{{ 'link.created_label'|trans }}: {{ link.createdAt|date('Y-m-d H:i') }}</span>
    </p>
    {% if link.tags|length > 0 %}
        <div>{% for t in link.tags %}<a href="{{ path('links_index', {tag: t.id}) }}"><span class="tag">#{{ t.name }}</span></a>{% endfor %}</div>
    {% endif %}
    {% if link.aiSummary %}<div class="card" style="border-left:3px solid var(--primary);"><h3>✨ {{ 'link.ai_summary'|trans }}</h3><p>{{ link.aiSummary }}</p></div>{% endif %}
    {% if link.description %}<div class="card"><h3>{{ 'link.description'|trans }}</h3><p>{{ link.description }}</p></div>{% endif %}
    {% if link.textContent %}
        <div class="card"><h3>{{ 'link.readable'|trans }}</h3><div style="white-space:pre-wrap; max-height:600px; overflow:auto;">{{ link.textContent }}</div></div>
    {% endif %}
    <div class="card">
        <h3>{{ 'link.archives'|trans }}</h3>
        {% if assets is empty %}
            <p class="muted" style="margin:0;">{{ 'link.no_archives'|trans }}</p>
        {% else %}
            <div class="row">
                {% for asset in assets %}
                    {% set icon = {'pdf': '📄', 'screenshot': '🖼️', 'singlefile': '🗂️', 'raw_html': '📄'} %}
                    <a class="btn btn-sm" href="{{ path('archive_asset_serve', {id: asset.id}) }}" target="_blank" rel="noopener">
                        {{ icon[asset.kind] ?? '📎' }} {{ ('link.asset.' ~ asset.kind)|trans }}
                        <span class="muted">· {{ (asset.sizeBytes / 1024)|round }} {{ 'link.kb'|trans }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    {% if link.lastError %}<div class="card" style="border-color: var(--danger);"><h3>{{ 'link.last_error'|trans }}</h3><pre>{{ link.lastError }}</pre></div>{% endif %}
    <div class="row" style="margin-top: 20px;">
        <form class="inline" method="post" action="{{ path('links_rearchive', {id: link.id}) }}">
            <button class="btn" type="submit">↻ {{ 'link.rearchive_now'|trans }}</button>
        </form>
        <form class="inline" method="post" action="{{ path('links_delete', {id: link.id}) }}" onsubmit="return confirm('{{ 'common.confirm_delete'|trans }}');">
            <button class="btn btn-danger" type="submit">{{ 'common.delete'|trans }}</button>
        </form>
    </div>
{% endblock %}
