{% extends 'base.html.twig' %}
{% block title %}{{ 'dead.title'|trans }}{% endblock %}
{% block body %}
    <header class="top">
        <h1>💀 {{ 'dead.title'|trans }}</h1>
        <a href="{{ path('dashboard') }}" class="btn">{{ 'common.back'|trans }}</a>
    </header>
    <p class="muted">{{ 'dead.intro'|trans }}</p>
    <p class="muted" id="dead-empty"{% if links is not empty %} hidden{% endif %}>{{ 'dead.none'|trans }}</p>
    {% if links is not empty %}
        <div class="link-list" data-dead-list>
            {% for link in links %}{% include 'links/_card.html.twig' with {ajax_delete: true} %}{% endfor %}
        </div>
    {% endif %}

    {% if unreachable is not empty %}
        <section style="margin-top:28px;">
            <h2>📡 {{ 'dead.unreachable_title'|trans }} <span class="muted">({{ unreachable|length }})</span></h2>
            <p class="muted">{{ 'dead.unreachable_intro'|trans }}</p>
            {% if unreachable_domains is not empty %}
                <div class="dead-domains">
                    {% for d in unreachable_domains %}
                        <form class="dead-domain" method="post" action="{{ path('links_unreachable_domain_delete') }}"
                              onsubmit="return confirm('{{ 'dead.domain_confirm'|trans({'%count%': d.count, '%host%': d.host}) }}');">
                            <input type="hidden" name="host" value="{{ d.host }}">
                            <input type="hidden" name="return_to" value="{{ app.request.basePath }}{{ app.request.pathInfo }}">
                            <span class="muted">{{ 'dead.domain_summary'|trans({'%count%': d.count, '%host%': d.host}) }}</span>
                            <button class="btn btn-sm btn-danger" type="submit">🗑️ {{ 'dead.domain_delete'|trans }}</button>
                        </form>
                    {% endfor %}
                </div>
            {% endif %}
            <div class="link-list">
                {% for link in unreachable %}{% include 'links/_card.html.twig' with {ajax_delete: true} %}{% endfor %}
            </div>
        </section>
    {% endif %}

    {% if duplicates is not empty %}
        <section style="margin-top:28px;">
            <h2>👯 {{ 'dead.duplicates_title'|trans }} <span class="muted">({{ duplicates|length }})</span></h2>
            <p class="muted">{{ 'dead.duplicates_intro'|trans }}</p>
            {% for group in duplicates %}
                <details class="dup-group" open style="margin-bottom:12px;">
                    <summary style="cursor:pointer;word-break:break-all;">{{ group[0].url }} <span class="muted">×{{ group|length }}</span></summary>
                    <div class="link-list">
                        {% for link in group %}{% include 'links/_card.html.twig' with {ajax_delete: true} %}{% endfor %}
                    </div>
                </details>
            {% endfor %}
        </section>
    {% endif %}

    <script>
        // Delete straight away (no confirm, no page reload): POST via fetch, drop the card.
        // Only cards in the top 404 list decrement the sidebar "dead" badge; unreachable
        // and duplicate cards do not. Emptying a duplicate volet removes just that volet.
        document.querySelectorAll('form[data-ajax-delete]').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var isDead = form.closest('[data-dead-list]') !== null;
                fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) {
                        if (!r.ok) { return; }
                        var card = form.closest('.link-card');
                        if (!card) { return; }
                        var list = card.closest('.link-list');
                        var group = card.closest('.dup-group');
                        card.remove();
                        if (list && !list.querySelector('.link-card')) {
                            if (group) { group.remove(); }
                            else {
                                var section = list.closest('section');
                                if (section) { section.remove(); } else { list.remove(); }
                            }
                        }
                        if (isDead) {
                            var badge = document.querySelector('.nav a .count-danger');
                            if (badge) {
                                var n = parseInt(badge.textContent, 10) - 1;
                                if (n > 0) { badge.textContent = n; } else { badge.remove(); }
                            }
                        }
                        if (!document.querySelector('.link-card')) {
                            document.getElementById('dead-empty').hidden = false;
                        }
                    });
            });
        });
    </script>
{% endblock %}
