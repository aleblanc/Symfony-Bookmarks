{% import '_partials/_folder_icon.html.twig' as fi %}
<article class="link-card">
    <a class="link-thumb" href="{{ link.url }}" target="_blank" rel="noopener" data-click-id="{{ link.id }}"
       {% if not link.previewImage %}style="background: linear-gradient(135deg, {{ link.collection.color }}22, {{ link.collection.color }}66);"{% endif %}>
        {% if link.previewImage %}
            <img src="{{ path('link_preview', {id: link.id}) }}" alt="" loading="lazy">
        {% elseif link.iconPath %}
            <img class="link-thumb-fav" src="{{ app.request.basePath }}{{ link.iconPath }}" alt="">
        {% else %}🔗{% endif %}
    </a>
    <div class="link-content">
        <a class="link-title" href="{{ link.url }}" target="_blank" rel="noopener" data-click-id="{{ link.id }}">
            {% if link.iconPath %}<img class="favicon" src="{{ app.request.basePath }}{{ link.iconPath }}" alt="">{% endif %}
            <span>{{ link.name ?: link.url }}</span>
        </a>
        <div class="link-domain muted">{{ (link.url|split('/'))[2]|default(link.url) }}</div>
        {% if link.tags is not empty %}
            <div class="link-tags">
                {% for tag in link.tags %}<a href="{{ path('links_index', {tag: tag.id}) }}" class="tag">#{{ tag.name }}</a>{% endfor %}
            </div>
        {% endif %}
        {% set pdf = link.getAsset('pdf') %}
        {% set shot = link.getAsset('screenshot') %}
        <div class="link-foot">
            <span class="link-meta muted">
                <a href="{{ path('collections_show', {id: link.collection.id}) }}" class="cname">{{ fi.icon(link.collection) }} {{ link.collection.name }}</a>
                {% if link.collection.skipProcessing %}
                    <span class="badge unsorted">{{ 'status.value.unsorted'|trans }}</span>
                {% else %}
                    <span class="badge {{ link.status }}">{{ ('status.value.' ~ link.status)|trans }}</span>
                {% endif %}
                {% if link.isDead %}
                    <span class="badge failed">💀 {{ 'link.dead'|trans }}{% if link.httpStatus %} ({{ link.httpStatus }}){% endif %}</span>
                {% endif %}
            </span>
            <span class="link-actions">
                {% if pdf %}<a class="icon-btn" href="{{ path('archive_asset_serve', {id: pdf.id}) }}" target="_blank" rel="noopener" title="{{ 'link.asset.pdf'|trans }}" aria-label="{{ 'link.asset.pdf'|trans }}"><svg class="ic-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#E2231A" d="M6 2h8l4 4v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><path fill="#fff" fill-opacity=".35" d="M14 2v4h4z"/><text x="10.7" y="18" text-anchor="middle" fill="#fff" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="6.4">PDF</text></svg></a>{% endif %}
                {% if shot %}<a class="icon-btn" href="{{ path('archive_asset_serve', {id: shot.id}) }}" target="_blank" rel="noopener" title="{{ 'link.asset.screenshot'|trans }}" aria-label="{{ 'link.asset.screenshot'|trans }}">🖼️</a>{% endif %}
                <a class="icon-btn" href="{{ path('links_show', {id: link.id}) }}" title="{{ 'common.details'|trans }}" aria-label="{{ 'common.details'|trans }}">👁️</a>
                <form class="inline" method="post" action="{{ path('links_rearchive', {id: link.id}) }}">
                    <button class="icon-btn" type="submit" title="{{ 'common.rearchive'|trans }}" aria-label="{{ 'common.rearchive'|trans }}">↻</button>
                </form>
                <form class="inline" method="post" action="{{ path('links_delete', {id: link.id}) }}" onsubmit="return confirm('{{ 'common.confirm_delete_link'|trans }}');">
                    {# basePath carries the reverse-proxy sub-path (X-Forwarded-Prefix); requestUri does not. #}
                    <input type="hidden" name="return_to" value="{{ app.request.basePath }}{{ app.request.pathInfo }}{% if app.request.queryString %}?{{ app.request.queryString }}{% endif %}">
                    <button class="icon-btn icon-btn--danger" type="submit" title="{{ 'common.delete'|trans }}" aria-label="{{ 'common.delete'|trans }}">🗑️</button>
                </form>
            </span>
        </div>
    </div>
</article>
